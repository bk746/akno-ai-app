{
  "name": "aknoai-app",
  "version": "1.0.0",
  "buildNumber": 1,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:assistant": "esbuild scripts/test-assistant.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test.mjs --log-level=warning && node /tmp/akno-test.mjs",
    "test:twilio": "esbuild scripts/test-twilio.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-twilio.mjs --log-level=warning && node /tmp/akno-test-twilio.mjs",
    "test:receptionist": "esbuild scripts/test-receptionist.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-receptionist.mjs --log-level=warning && node /tmp/akno-test-receptionist.mjs",
    "test:factures": "esbuild scripts/test-factures.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-factures.mjs --log-level=warning && node /tmp/akno-test-factures.mjs",
    "test:chantiers": "esbuild scripts/test-chantiers.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-chantiers.mjs --log-level=warning && node /tmp/akno-test-chantiers.mjs",
    "test:equipe": "esbuild scripts/test-equipe.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-equipe.mjs --log-level=warning && node /tmp/akno-test-equipe.mjs",
    "test:clients": "esbuild scripts/test-clients.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-clients.mjs --log-level=warning && node /tmp/akno-test-clients.mjs",
    "test:chaine": "esbuild scripts/test-chaine.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/akno-test-chaine.mjs --log-level=warning && node node_modules/.cache/akno-test-chaine.mjs",
    "test:chaine-ui": "node scripts/test-chaine-ui.mjs",
    "test:native": "node scripts/test-native.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:build": "node scripts/version.mjs build",
    "version:sync": "node scripts/version.mjs sync",
    "cap:sync": "npm run build && node scripts/version.mjs sync && npx cap sync",
    "cap:assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'",
    "test:bottom": "node scripts/test-bottom.mjs",
    "test:navbar": "node scripts/test-navbar.mjs",
    "test:history": "node scripts/test-history.mjs",
    "test:rec-reglages": "node scripts/test-rec-reglages.mjs",
    "test:forward": "esbuild scripts/test-forward.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-forward.mjs --log-level=warning && node /tmp/akno-test-forward.mjs",
    "test:phone-provision": "esbuild scripts/test-phone-provision.ts --bundle --platform=node --format=esm --outfile=/tmp/akno-test-phone-provision.mjs --log-level=warning && node /tmp/akno-test-phone-provision.mjs",
    "test:safe-top": "node scripts/test-safe-top.mjs",
    "test:facture-open": "node scripts/test-facture-open.mjs",
    "test:rdv-fields": "node scripts/test-rdv-fields.mjs",
    "test:doc-swipe": "node scripts/test-doc-swipe.mjs",
    "test:agenda-78": "node scripts/test-agenda-78.mjs",
    "test:cal-tabs": "node scripts/test-cal-tabs.mjs",
    "test:update80": "node scripts/test-update80.mjs",
    "test:update81": "node scripts/test-update81.mjs",
    "test:update82": "node scripts/test-update82.mjs",
    "test:update83": "node scripts/test-update83.mjs",
    "test:update84": "node scripts/test-update84.mjs",
    "test:update85": "node scripts/test-update85.mjs",
    "test:client-picker": "node scripts/test-client-picker.mjs",
    "test:devis-ui": "node scripts/test-devis-ui.mjs",
    "test:devis-pdf": "esbuild scripts/render-devis-pdf.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/akno-render-devis.mjs --log-level=warning && node node_modules/.cache/akno-render-devis.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
