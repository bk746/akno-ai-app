VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Server-only (Vercel / vite dev). Never prefix with VITE_.
# XAI_API_KEY=
# Cal.com → Settings → Developer → API keys (https://app.cal.com/settings/developer/api-keys)
# CALCOM_API_KEY=
# Optional numeric event-type id (from the event type URL). If omitted, the first visible type is used.
# CALCOM_EVENT_TYPE_ID=

# Resend → https://resend.com/api-keys (server-only, never prefix with VITE_)
# RESEND_API_KEY=
# Optional from address. Defaults to Akno <onboarding@resend.dev> for testing.
# RESEND_FROM=
# Optional chat model for devis drafts (defaults to grok-4-latest)
# XAI_CHAT_MODEL=

# Public site URL used in devis / reminder links (no trailing slash)
# APP_URL=https://akno-ai-app-v2.vercel.app

# Vercel Cron → /api/relances daily at 08:00 UTC (09:00 Europe/Paris in winter)
# Generate with: openssl rand -hex 32
# Vercel sends it automatically as: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Supabase service role (server-only). Dashboard → Project Settings → API → service_role (secret).
# Never prefix with VITE_ and never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: verified Resend receiving domain (MX pointed to Resend).
# When set, devis emails use Reply-To devis+<token>@that-domain so replies hit /api/resend-webhook.
# If unset, Reply-To falls back to the artisan email.
# RESEND_INBOUND_DOMAIN=
# Signing secret of the Resend webhook (event email.received → https://<app>/api/resend-webhook)
# RESEND_WEBHOOK_SECRET=

# Web Push (VAPID). Public key is bundled in the client. Private key is server-only — never prefix with VITE_.
# Copy the generated values from /workspace/akno-vapid.env (do not commit the private key).
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:aknoweb.contact@gmail.com

