VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Server-only (Vercel / vite dev). Never prefix with VITE_.
# XAI_API_KEY=
# Cal.com → Settings → Developer → API keys (https://app.cal.com/settings/developer/api-keys)
# CALCOM_API_KEY=
# Optional numeric event-type id (from the event type URL). If omitted, the first visible type is used.
# CALCOM_EVENT_TYPE_ID=

# Resend → https://resend.com/api-keys (server-only, never prefix with VITE_)
# RESEND_API_KEY=
# Optional from address. Defaults to Akno <onboarding@resend.dev> for testing.
# RESEND_FROM=
# Optional chat model for devis drafts (defaults to grok-4-latest)
# XAI_CHAT_MODEL=

# Public site URL used in devis / reminder links (no trailing slash)
# APP_URL=https://akno-ai-app-v2.vercel.app

# Vercel Cron → /api/relances daily at 08:00 UTC (09:00 Europe/Paris in winter)
# Generate with: openssl rand -hex 32
# Vercel sends it automatically as: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Supabase service role (server-only). Dashboard → Project Settings → API → service_role (secret).
# Never prefix with VITE_ and never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: verified Resend receiving domain (MX pointed to Resend).
# When set, devis emails use Reply-To devis+<token>@that-domain so replies hit /api/resend-webhook.
# If unset, Reply-To falls back to the artisan email.
# RESEND_INBOUND_DOMAIN=
# Signing secret of the Resend webhook (event email.received → https://<app>/api/resend-webhook)
# RESEND_WEBHOOK_SECRET=

# Web Push (VAPID). Public key is bundled in the client. Private key is server-only — never prefix with VITE_.
# Copy the generated values from /workspace/akno-vapid.env (do not commit the private key).
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:aknoweb.contact@gmail.com


# ======================================================================
# update44 → 48 (toutes facultatives : sans elles, la fonction est désactivée proprement)
# ======================================================================

# --- Stripe (abonnements). Sans STRIPE_SECRET_KEY : accès ouvert à tous, pas de mur de paiement.
# Dashboard Stripe → Développeurs → Clés API (sk_live_… ou sk_test_…)
# STRIPE_SECRET_KEY=
# Développeurs → Webhooks → endpoint https://<app>/api/stripe-webhook → « Signing secret » (whsec_…)
# Événements : checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed
# STRIPE_WEBHOOK_SECRET=
# Catalogue → produits → prix récurrents HT (price_…)
# STRIPE_PRICE_BUREAU=        # 89 € HT / mois
# STRIPE_PRICE_CLIENTS=       # 199 € HT / mois
# STRIPE_PRICE_RECEPTION=     # option 50 € HT / mois
# STRIPE_TRIAL_DAYS=30
# update46 · prix ANNUELS (-20 %). Si l'un manque, l'app ne propose que le mensuel.
# STRIPE_PRICE_BUREAU_ANNUAL=     # 854,40 € HT / an
# STRIPE_PRICE_CLIENTS_ANNUAL=    # 1 910,40 € HT / an
# STRIPE_PRICE_RECEPTION_ANNUAL=  # option 480 € HT / an
# update46 · paiement intégré dans l'app (Stripe Embedded Checkout). Clé PUBLIQUE (pk_…), sans danger côté client.
# Sans elle, l'app redirige vers la page de paiement Stripe hébergée (aux couleurs Akno aussi).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51UbHG5QWhQkqONW7BUhgtUbSqE0ldd5A4cpCrGgGmU3qiCYgTNMJYmofIFTo1MrqnZYwAA8ulVGblf62ODrsWSuJ00yTaRfxAI
# TVA : soit un taux fixe (txr_… pour 20 %), soit Stripe Tax automatique (=1)
# STRIPE_TAX_RATE_ID=
# STRIPE_AUTOMATIC_TAX=

# --- Twilio (SMS + numéro de téléphone). Sans ces clés : aucun SMS n'est envoyé (jamais de faux « envoyé »).
# Console Twilio → Account Info
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Messaging → Services (MG…) — recommandé ; sinon un numéro expéditeur en TWILIO_FROM (+33…)
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM=
# Nom d'expéditeur alphanumérique par défaut (11 caractères max.)
# TWILIO_SENDER_NAME=Akno

# --- Formulaire du site (/api/lead) : anti-robot Cloudflare Turnstile facultatif
# TURNSTILE_SECRET_KEY=

# --- Cal.com : la clé globale ci-dessus ne sert plus qu'à UN compte (le vôtre).
# Mettez ici votre artisan_id (uuid Supabase). Les autres artisans saisissent leur propre clé dans Paramètres › Agenda.
# CALCOM_OWNER_ARTISAN_ID=

# --- Suivi des erreurs Sentry (facultatif)
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# --- Support et pages légales (affichés dans l'app)
# VITE_SUPPORT_EMAIL=
# VITE_SUPPORT_URL=
# VITE_LEGAL_NAME=
# VITE_LEGAL_FORM=
# VITE_LEGAL_ADDRESS=
# VITE_LEGAL_SIRET=
# VITE_LEGAL_TVA=
# VITE_LEGAL_DIRECTOR=
# VITE_LEGAL_EMAIL=
# VITE_LEGAL_DPO_EMAIL=
